{
  "name": "landscape-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "cross-env HTTPS=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "optimize-model": "gltf-transform optimize --texture-compress webp --texture-size 512 --simplify-ratio 0.03 --simplify-error 0.01 --compress meshopt"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/xr": "^5.7.1",
    "jspdf": "^2.5.2",
    "konva": "^9.3.16",
    "lucide-react": "^0.454.0",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-router-dom": "^6.28.0",
    "three": "^0.160.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-mkcert": "^1.17.12"
  }
}
